# Server environment template (names only, no values).
# Copy to .env for local development. Real environment files are git-ignored.
# Development loads .env through Node's --env-file-if-exists flag (see the dev script).
# Production values come from the hosting platform's settings.
#
# The categories follow TD-046 and ARCHITECTURE_DESIGN.md Section 14.2.
# The server refuses to start, naming the variables at fault, when any of these is missing or
# invalid. An empty value counts as not set. A variable with a default below may be left empty.
# Secrets never have defaults and are never committed. Generate each one separately, for each
# environment, with: openssl rand -hex 32

# Runtime
# NODE_ENV is required: development, test, or production
NODE_ENV=
# Default 5000
PORT=
# Default 10, from 1 to 120. How long in-flight requests may finish during shutdown (TD-047)
SHUTDOWN_TIMEOUT_SECONDS=
# Default 0, from 0 to 10. Proxy steps whose forwarded client address is trusted (TD-027).
# Set it to the number of proxies the hosting platform puts between the visitor and this server,
# and no more. Too low: all visitors share one address, so one can use up everyone's rate limit,
# and production sees every request as unencrypted. Too high: a visitor can pick their own address.
# Check it in the launch check (R-23). The platform must forward the original protocol.
TRUST_PROXY_HOPS=
# Default info. One of fatal, error, warn, info, debug. The least severe level that is logged (TD-028)
LOG_LEVEL=

# Database (required, secret): a mongodb:// or mongodb+srv:// connection string
DATABASE_URL=

# Media service (all required; the key and the secret are secrets)
# The cloud name also decides which images the content security policy allows (TD-029)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Session
# Signing secrets (required, secret): at least 32 characters, and different from each other
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
# Lifetimes in seconds (TD-016). The access lifetime may not exceed the inactivity limit, and the
# inactivity limit may not exceed the maximum lifetime
# Default 900 (15 minutes)
ACCESS_TOKEN_TTL_SECONDS=
# Default 7200 (2 hours)
SESSION_INACTIVITY_LIMIT_SECONDS=
# Default 86400 (24 hours)
SESSION_MAX_LIFETIME_SECONDS=

# Limits (API_DESIGN.md Sections 7.10 and 9.1, TD-027)
# Page sizes. A default may not exceed its maximum
# Default 12
PAGE_SIZE_PROJECTS_DEFAULT=
# Default 10
PAGE_SIZE_ARTICLES_DEFAULT=
# Default 20
PAGE_SIZE_ADMIN_DEFAULT=
# Default 50
PAGE_SIZE_PUBLIC_MAX=
# Default 100
PAGE_SIZE_ADMIN_MAX=
# Default 5242880 (5 MB per image)
UPLOAD_MAX_BYTES=
# Default 60
DUPLICATE_MESSAGE_WINDOW_SECONDS=

# Rate limits (TD-027): one maximum and one window in seconds per route group
# Public reads. Defaults 120 per 60
RATE_LIMIT_PUBLIC_READ_MAX=
RATE_LIMIT_PUBLIC_READ_WINDOW_SECONDS=
# Contact submission. Defaults 5 per 3600
RATE_LIMIT_CONTACT_MAX=
RATE_LIMIT_CONTACT_WINDOW_SECONDS=
# Sign-in. Defaults 10 per 900
RATE_LIMIT_SIGN_IN_MAX=
RATE_LIMIT_SIGN_IN_WINDOW_SECONDS=
# Session renewal. Defaults 20 per 900
RATE_LIMIT_RENEWAL_MAX=
RATE_LIMIT_RENEWAL_WINDOW_SECONDS=
# Admin endpoints. Defaults 120 per 60
RATE_LIMIT_ADMIN_MAX=
RATE_LIMIT_ADMIN_WINDOW_SECONDS=
# Image upload. Defaults 20 per 600
RATE_LIMIT_UPLOAD_MAX=
RATE_LIMIT_UPLOAD_WINDOW_SECONDS=

# Site (required): the public address, an absolute http or https URL.
# Also the only origin the cross-site check accepts and the host of the https redirect (TD-029, TD-030)
SITE_URL=