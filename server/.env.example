# Server environment template (names only, no values).
# Copy to .env for local development. Real environment files are git-ignored.
#
# The categories follow TD-046 and ARCHITECTURE_DESIGN.md Section 14.2.
# Names are finalized, with validation and defaults, in Milestone 2.2.
# Secrets never have defaults and are never committed.

# Runtime
NODE_ENV=
PORT=

# Database
DATABASE_URL=

# Media service
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=

# Session: signing secrets and lifetimes (access, inactivity limit, absolute maximum)
ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=
SESSION_INACTIVITY_LIMIT=
SESSION_MAX_LIFETIME=

# Limits: page sizes, upload size, duplicate-message window
PAGE_SIZE_DEFAULT=
PAGE_SIZE_MAX=
UPLOAD_MAX_BYTES=
DUPLICATE_MESSAGE_WINDOW_SECONDS=

# Rate limits, one window and one maximum per route group (TD-027)
RATE_LIMIT_PUBLIC_READ=
RATE_LIMIT_CONTACT=
RATE_LIMIT_SIGN_IN=
RATE_LIMIT_RENEWAL=
RATE_LIMIT_ADMIN=
RATE_LIMIT_UPLOAD=

# Hosting: number of proxy steps whose forwarded client address is trusted (TD-027)
TRUST_PROXY_HOPS=

# Site: public address of the site
SITE_URL=
